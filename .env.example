# Copy to .env.local and fill in. Never commit .env.local.

# Required: Claude API key (https://platform.claude.com -> API keys)
# Or a LiteLLM (or other gateway) virtual key, together with ANTHROPIC_BASE_URL below.
ANTHROPIC_API_KEY=

# Optional: only when using a gateway such as LiteLLM instead of the Claude API directly.
# The gateway's base URL (no /v1 at the end), e.g. https://litellm.example.edu
ANTHROPIC_BASE_URL=
# Optional: the model name as the gateway knows it (default: claude-opus-5-5)
CHAT_MODEL=

# Optional: raises GitHub rate limits and enables pinned-repo ordering.
# A fine-grained token with read-only public repo access is enough.
GITHUB_TOKEN=

# Optional: public URL of the site, used for absolute resume links (e.g. https://yourname.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Optional: lets the chat forward recruiter messages to you by email (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend; defaults to onboarding@resend.dev (only delivers to your own Resend account email)
CONTACT_FROM_EMAIL=

# Optional: shared rate limiting across serverless instances (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
